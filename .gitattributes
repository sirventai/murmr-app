# Set default behaviour to automatically normalize line endings
* text=auto eol=lf

# Explicit binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf

# Gradle scripts and wrappers
gradlew text eol=lf
gradlew.bat text eol=crlf
*.gradle.kts text eol=lf
*.properties text eol=lf

# Source code
*.kt text eol=lf
*.swift text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.cff text eol=lf
*.sh text eol=lf
