-- Contactos emparejados desde este dispositivo. Cada fila representa una
-- relación bilateral con otro `device_id`. La constraint UNIQUE evita que un
-- mismo contacto aparezca dos veces (importante porque al re-emparejar se
-- reutiliza el contact_id para no perder histórico de chat).
--
-- remote_public_key se guarda íntegro para poder regenerar el fingerprint en
-- cualquier momento, incluso si la sesión activa se pierde por algún motivo.
--
-- avatar y last_alias_synced_at se actualizan automáticamente cuando llega un
-- mensaje PROFILE_UPDATE del peer (sync sin re-emparejar).
-- avatar = thumbnail 256 px que el peer difunde en PROFILE_UPDATE (rápido).
-- avatar_big = versión grande, vacía hasta que la pedimos con AVATAR_REQUEST y
-- el peer responde con AVATAR_BIG. Se cachea para no volver a pedirla. Si el
-- peer cambia su avatar, vuelve a llegar PROFILE_UPDATE|AVATAR (el thumbnail
-- nuevo) - la app debería invalidar avatar_big para forzar refetch al tap.
-- relay_url: URL del relay con el que se hizo el pairing. Permite tener distintos
-- contactos por servidor - al cambiar el relay en Settings los contactos del relay
-- viejo no aparecen en las listas (siguen en BD por si vuelves al relay original).
-- peer_session_expiry y peer_custom_expiry_days: la configuración de caducidad
-- de sesión que el peer NOS ha comunicado. Se actualiza cuando recibimos
-- EXPIRY_UPDATE|<enum>|<days>. La sesión efectiva entre los dos lados es la más
-- restrictiva: min(localExpiry, peerExpiry). Si ambos son NEVER, la sesión no
-- caduca. Por defecto NEVER hasta que el peer nos diga lo contrario.
-- local_session_expiry y local_custom_expiry_days: override POR CHAT de la
-- expiración. Si es NULL hereda del Settings global (default). Si tiene valor,
-- se aplica solo a este contacto. Cambiar la expiry desde el chat tipo Telegram
-- modifica este override; cambiar el default desde Ajustes solo afecta a los
-- contactos que NO tengan override propio.
CREATE TABLE contacts (
    contact_id              TEXT NOT NULL PRIMARY KEY,
    owner_device_id         TEXT NOT NULL,
    remote_device_id        TEXT NOT NULL,
    remote_public_key       BLOB NOT NULL,
    display_alias           TEXT NOT NULL,
    status                  TEXT NOT NULL,
    paired_at               INTEGER NOT NULL,
    last_message_at         INTEGER,
    unread_count            INTEGER NOT NULL DEFAULT 0,
    last_alias_synced_at    INTEGER,
    avatar                  BLOB,
    avatar_big              BLOB,
    relay_url                TEXT NOT NULL DEFAULT '',
    peer_session_expiry      TEXT NOT NULL DEFAULT 'NEVER',
    peer_custom_expiry_seconds INTEGER NOT NULL DEFAULT 0,
    local_session_expiry     TEXT,
    local_custom_expiry_seconds INTEGER NOT NULL DEFAULT 0,
    UNIQUE (owner_device_id, remote_device_id)
);

CREATE INDEX contacts_by_owner ON contacts(owner_device_id, status);
CREATE INDEX contacts_by_last_msg ON contacts(owner_device_id, last_message_at);

selectAll:
SELECT *
FROM contacts
WHERE owner_device_id = :owner
ORDER BY (last_message_at IS NULL), last_message_at DESC, paired_at DESC;

-- Lista filtrada por relay actual: usada por la UI principal para no mostrar
-- contactos de otros servidores. `selectAll` se mantiene para casos donde
-- realmente queremos todos (delete account, etc).
selectAllByRelay:
SELECT *
FROM contacts
WHERE owner_device_id = :owner AND relay_url = :relayUrl
ORDER BY (last_message_at IS NULL), last_message_at DESC, paired_at DESC;


selectById:
SELECT *
FROM contacts
WHERE contact_id = :contactId;

selectByRemote:
SELECT *
FROM contacts
WHERE owner_device_id = :owner AND remote_device_id = :remote;

insert:
INSERT INTO contacts(contact_id, owner_device_id, remote_device_id, remote_public_key, display_alias, status, paired_at, last_message_at, unread_count, last_alias_synced_at, avatar, avatar_big, relay_url, peer_session_expiry, peer_custom_expiry_seconds, local_session_expiry, local_custom_expiry_seconds)
VALUES (:contactId, :ownerDeviceId, :remoteDeviceId, :remotePublicKey, :displayAlias, :status, :pairedAt, :lastMessageAt, :unreadCount, :lastAliasSyncedAt, :avatar, NULL, :relayUrl, 'NEVER', 0, :localSessionExpiry, :localCustomExpirySeconds);

updatePeerExpiry:
UPDATE contacts
SET peer_session_expiry = :peerSessionExpiry, peer_custom_expiry_seconds = :peerCustomExpirySeconds
WHERE contact_id = :contactId;

updateLocalExpiry:
UPDATE contacts
SET local_session_expiry = :localSessionExpiry, local_custom_expiry_seconds = :localCustomExpirySeconds
WHERE contact_id = :contactId;

clearLocalExpiry:
UPDATE contacts
SET local_session_expiry = NULL, local_custom_expiry_seconds = 0
WHERE contact_id = :contactId;

updateAlias:
UPDATE contacts
SET display_alias = :alias
WHERE contact_id = :contactId;

updateAliasSynced:
UPDATE contacts
SET display_alias = :alias, last_alias_synced_at = :ts
WHERE contact_id = :contactId;

updateAvatarRemote:
UPDATE contacts
SET avatar = :avatar, avatar_big = NULL
WHERE contact_id = :contactId;

-- Cache del avatar grande recibido tras AVATAR_REQUEST. Se invalida (NULL) cada
-- vez que el peer manda un PROFILE_UPDATE|AVATAR nuevo, para forzar refetch.
updateAvatarBigRemote:
UPDATE contacts
SET avatar_big = :avatarBig
WHERE contact_id = :contactId;

updateStatus:
UPDATE contacts
SET status = :status
WHERE contact_id = :contactId;

touchLastMessage:
UPDATE contacts
SET last_message_at = :ts
WHERE contact_id = :contactId;

incrementUnread:
UPDATE contacts
SET unread_count = unread_count + 1, last_message_at = :ts
WHERE contact_id = :contactId;

resetUnread:
UPDATE contacts
SET unread_count = 0
WHERE contact_id = :contactId;

totalUnread:
SELECT COALESCE(SUM(unread_count), 0) AS total FROM contacts;

deleteById:
DELETE FROM contacts
WHERE contact_id = :contactId;

deleteAll:
DELETE FROM contacts;
